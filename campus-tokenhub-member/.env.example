# ---- OctaFuse 网关 ----
# 注意：这里不配置腾讯云 TokenHub 的 Key。学校部署后由管理员登录 /setup 自己录入，
# 门户会把它写进网关 providers 表；不要把任何真实 Key 写进本文件或镜像。
# Admin/Proxy 都填到不带 /api 的根，例如 http://127.0.0.1:8789 / http://127.0.0.1:8790
# 注意：docker compose 全栈部署时，门户容器会改用 compose 网络里的服务名
# （http://gateway-admin:8789 / http://gateway-proxy:8787），这两项只在容器外直连网关时才生效
OCTAFUSE_ADMIN_BASE=http://127.0.0.1:8789
OCTAFUSE_PROXY_BASE=http://127.0.0.1:8790
# 浏览器直连网关用的地址（学生能看到，需公网可达）
# 浏览器直连的模型代理地址。线上填 https://api.aiedu.tencent.com/tokenhub：
# 模型代理接口对外**继续走老域名**（不随整站迁到 zhiqi.woa.com），nginx 负责剥前缀
NEXT_PUBLIC_PROXY_BASE=http://127.0.0.1:8790
# 管理员账号密码，用于登录换取会话 Cookie（不是 Bearer key）
OCTAFUSE_ADMIN_USERNAME=admin
OCTAFUSE_ADMIN_PASSWORD=change-me
# 外部身份命名空间，学生在该系统内的唯一标识写进 external_user_id
OCTAFUSE_EXTERNAL_SYSTEM=campus-tokenhub

# ---- 网关正文留存（调用详情抽屉里的「输入内容 / 输出内容」）----
# **默认开启**：不配置也是 on。捕获请求正文与模型输出写入 request_content 表，
# 按自然月分区、超过保留天数整月清理。off 只用于紧急回滚与压测基线。
# 只有部署新版本网关之后发生的调用才会落库，历史日志不会补写。
REQUEST_CONTENT_CAPTURE=on
# 单侧正文上限（字符）；门户展示时还会再裁到 2 万字符
REQUEST_CONTENT_MAX_CHARS=65536
# 批量写入：每批条数与攒批间隔（毫秒）
REQUEST_CONTENT_BATCH_SIZE=50
REQUEST_CONTENT_FLUSH_MS=500
# 分区维护：保留天数与巡检间隔（毫秒）；多副本靠 advisory lock 只跑一个
REQUEST_CONTENT_MAINTENANCE=on
REQUEST_CONTENT_RETENTION_DAYS=90
REQUEST_CONTENT_MAINTENANCE_INTERVAL_MS=3600000
# 对外访问根地址（线上必填，例如 https://zhiqi.woa.com/tokenhub/portal）。
# 配置后所有 302 与同源校验只认它，不再从 Host / X-Forwarded-Host 推导；留空仅适用于本地开发。
# 注意：这是**浏览器**访问的地址，带 /tokenhub/portal 前缀（nginx 对门户原样透传，不剥前缀）。
PUBLIC_BASE_URL=
# 门户挂载前缀（Next basePath）。线上填 /tokenhub/portal；**构建期生效**，改完必须重建镜像
PORTAL_BASE_PATH=
# 管理台公网前缀。线上填 /tokenhub/admin；nginx 会剥掉该前缀再转发到 8789，
# 容器内始终是根路径。只影响前端构建（资源路径、Router basename、浏览器请求），
# **构建期生效**，改完必须重建镜像；留空 = 根路径部署。
# 同一个值也会以运行期环境变量注入容器，仅用于入口脚本比对镜像构建前缀，不参与路由。
ADMIN_UI_PUBLIC_PATH=
# 管理台的公网地址（侧边栏「网关管理后台 ↗」跳这里），例如 https://zhiqi.woa.com/tokenhub/admin
ADMIN_PUBLIC_BASE_URL=

# ---- 客户端 IP 来源 ----
# 只有前面的反代用 $remote_addr **覆写** X-Forwarded-For（仓库自带 nginx/compose 就是这样）时才设 true。
# 换成自建反代（$proxy_add_x_forwarded_for 追加）或直接暴露 3000 端口时必须设 false 或留空，
# 否则客户端自带 XFF 就能换限流桶，绕过登录失败锁定、让审计 IP 失去溯源价值。
# 未开启时所有请求共用一个限流桶（不可伪造，但可能互相挤占）。
TRUST_PROXY_HEADERS=true
# 管理台会话 Cookie 是否带 Secure。CLB 终止 TLS 时置 1（或 true）
ADMIN_COOKIE_SECURE=

# ---- 管理台人类登录：复用门户 SSO ----
# 管理台只验签门户的 portal_session（与 SESSION_SECRET 同值，由 compose 注入）。
# 缺 PORTAL_SESSION_SECRET 不会阻塞启动，但管理台 SSO 不可用（/api/auth/check 返回 200 + reason）。
# 门户登录页/登出接口的绝对地址（浏览器会访问）：
#   local : http://localhost:3000/tokenhub/portal/login 与 .../api/auth/logout
#   lan   : http://<内网IP>:3000/tokenhub/portal/login
#   online: https://zhiqi.woa.com/tokenhub/portal/login
PORTAL_LOGIN_URL=
# 留空表示「退出管理台不清门户会话」；建议配置为 <PORTAL_LOGIN_URL 的上级>/api/auth/logout
PORTAL_LOGOUT_URL=
# portal（默认，人类只认门户会话）/ password（忽略门户会话，回到账密登录）/ both（两者都接受）
# 回滚只需把它改成 password 或 both 并重启管理台，不需要回滚代码
ADMIN_AUTH_MODE=portal

# ---- 统一入口 nginx（CLB 的 /tokenhub/* 转发到这里）----
NGINX_HOST_BIND=0.0.0.0
NGINX_HOST_PORT=8088
# 后端看到的协议：线上 https（CLB 终止 TLS）；本机 http 直连调试时改 http
NGINX_PUBLIC_PROTO=https

# ---- 全栈 docker compose（Postgres + OctaFuse）----
# 下面几项只在 docker compose 全栈部署时生效
POSTGRES_USER=octafuse
# 必填，留空时 compose 直接报错。生成：openssl rand -hex 24（只用十六进制，避免破坏 DATABASE_URL）
POSTGRES_PASSWORD=
POSTGRES_DB=octafuse
# 宿主机端口：nginx 8088（对外）/ 门户 3000 / Proxy 8790 / Admin 8789 / Postgres 5433
# 除 nginx 外都只绑 127.0.0.1，仅供本机排障
PORTAL_HOST_PORT=3200
GATEWAY_PROXY_HOST_PORT=8790
GATEWAY_ADMIN_HOST_PORT=8789
POSTGRES_HOST_PORT=5433
# 门户自有表（portal schema）的连接串：运营活动、审核管理员名单存在这里。
# - docker compose 部署时由 compose 覆盖成 `postgres:5432`，这里的值不影响容器
# - 宿主机跑 `npm run dev` 时用下面的 5433（compose 暴露的本机端口），口令与 POSTGRES_PASSWORD 一致
PORTAL_DATABASE_URL=postgres://octafuse:CHANGE_ME@127.0.0.1:5433/octafuse
# 网关源码目录（不入库）。本机默认指向 local-stack/octafuse-gateway；
# 换机器时 clone 网关后把这里改成实际路径即可
OCTAFUSE_GATEWAY_DIR=./local-stack/octafuse-gateway

# ---- 开户默认额度 ----
DEFAULT_BUDGET_MAX=100
DEFAULT_BUDGET_PERIOD=monthly

# ---- 开户默认限流（可选，留空表示不限）----
# 只在网关「真正建号」时写入；已存在用户不会被覆盖。设置页的同一项优先于此处的环境变量。
# 0 是有效值（拒绝全部），留空才是不限。
# DEFAULT_RATE_LIMIT_RPM=60
# DEFAULT_RATE_LIMIT_TPM=200000

# ---- 认证 ----
# 只支持 oauth2 / cas 两种标准 SSO 协议；旧值 aie 归一化为 oauth2，oidc / mock 不再支持。
#
# 默认路径（开箱即用）：登录参数由部署种子写进数据库，见
#   deploy/init/010-login-config.sql（AIE 的端点 / ClientID / 授权范围 / 字段映射）
# 所以下面这些都不必填——留空时门户按 oauth2 处理，参数从 DB 读。
#
# ⚠️ AUTH_PROVIDER 一旦显式写上，启动期就会强制要求同协议的 5 个 OAUTH2_* 值全部非空，
#    缺一个直接拒绝启动（避免带着半成品登录配置上线）。只有 DB 里完全没配、需要纯 env
#    兜底时才取消下面这段注释：
# AUTH_PROVIDER=oauth2
# OAUTH2_AUTHORIZATION_ENDPOINT=https://ai.edu.tencent.com/learning/#/login/oauth2?corp_code=dynl7sgpptcvye1b
# OAUTH2_TOKEN_ENDPOINT=https://eduplatform.translator.qq.com/aie/oauth2/access_token
# OAUTH2_USERINFO_ENDPOINT=https://eduplatform.translator.qq.com/aie/oauth2/user_info
# OAUTH2_CLIENT_ID=1010
# OAUTH2_SCOPES=openid profile email
# OAUTH2_TOKEN_AUTH_METHOD=client_secret_post
# OAUTH2_USERINFO_TOKEN_CARRIER=query
# CAS_LOGIN_URL=
# CAS_TICKET_VALIDATE_URL=
#
# 唯一需要在这里给的一项：client_secret 不能写进初始化 SQL（密文与部署机的
# SESSION_SECRET 绑定，换机器就解不开）。DB 里为空时用它兜底；部署后在
# 「设置 → 登录认证」里填一次就会加密落库，之后可以删掉这行。
OAUTH2_CLIENT_SECRET=
# 字段映射（auth.oauth2.fieldMap.*）与登录限制（auth.restrict.*）只在设置页维护，
# 存 portal.login_config，不提供环境变量（AIE 的映射已由部署种子写好）。
# 至少 32 字符随机串，用于签会话 JWT
# 必须是**高熵**随机串（openssl rand -base64 48）：长度够但字符单一（如 kkkkk…）会被启动校验拒绝，
# 因为 HS256 的密钥空间退化后可以被离线暴力还原，等于任何人都能伪造 admin 会话。
# 生产默认强制拒绝「指向本机回环或云元数据」的 SSO 出站地址（防 SSRF）；
# 私网段（10/8、172.16/12、192.168/16）不受影响。仅当 SSO 端点确实在本机时才临时设 off。
OUTBOUND_GUARD=enforce
SESSION_SECRET=please-change-this-to-a-random-32-char-secret
SESSION_TTL_HOURS=8
# 上 TLS 后必须 true。PUBLIC_BASE_URL 是 https:// 时会强制为 true，防止漏配。
# ---- 会话 Cookie 作用域（与统一采买站一致才能互认） ----
# 留空 = host-only：只对当前域名生效，不会漏到任何子域。**同域部署就用空值，最安全。**
# 只有两站分属不同子域、需要跨子域互认时才设父域（如 .school.edu.cn）——注意这是**扩大**作用域。
PORTAL_COOKIE_DOMAIN=
# Cookie 路径。默认 / 会让**同域名下所有路径**的服务都收到 portal_session。
# 两站同域不同前缀时（/tokenhub/portal 与 /tokenhub/member），这里必须填两站的**公共前缀** /tokenhub：
#   填 /tokenhub        → 两站共享同一个 Cookie（互认），且作用域收到门户这一段 ✅
#   填各自 basePath     → 两站各存一份 Cookie，互认断掉 ❌
PORTAL_COOKIE_PATH=/tokenhub
# 成员站挂在 /tokenhub/member 下：nginx 原样透传前缀，由 Next basePath 自己认。
# **构建期生效**，改完必须重建镜像。
PORTAL_BASE_PATH=/tokenhub/member
COOKIE_SECURE=false
# 业务时区：价格时段、活动「今天」、时间格式化共用。默认 Asia/Shanghai。
# 与网关 system_config.BUSINESS_TIMEZONE 保持一致，否则跨零点会错开一天。
BUSINESS_TIMEZONE=Asia/Shanghai

# ---- 部署管理员通道（引导期账号密码登录）----
# 配置入口 /settings 需要登录，而登录依赖学校 SSO。还没对接 SSO 的部署用这组账号完成第一次配置：
#   1) 填好下面两项（口令 ≥12 字符，建议 `openssl rand -base64 18`）；
#   2) 用它在登录页登录，登录后**直接落到「系统设置」**；
#   3) SSO 参数填齐后入口**不会自动关闭**——参数填齐 ≠ 调得通，请确认学校账号能正常登录后再置 off 并清空口令。
# **共享配置是唯一权威**：首次启动时若库里还没有口令，会把这两项加密写进
# `portal_shared.login_config`；库里一旦有值，改 .env 不再生效（启动日志会提示被忽略）。
# 与统一采买站同库部署时两站读同一行，口令天然一致；分栈部署（两个库）则必须把两处写成同一个值。
PORTAL_ADMIN_USERNAME=
PORTAL_ADMIN_PASSWORD=
# auto（默认：保留通道，由运维确认 SSO 调通后手动改 off）/ on（强制保留，仅救急用）/ off（关闭：已签发的密码会话立即失效）
PORTAL_ADMIN_LOGIN=auto

# ---- 门户行为 ----
# 逗号分隔；命中的是门户管理员：能看到网关后台外链与「初始化」入口。
# 留空时（如 IdP 不返回邮箱）初始化入口退回按网关里的 ONBOARDING_OWNER 判定。
# 侧边栏校名的兜底值，例如「演示学校」。登录返回真实校名时以登录值为准；留空回退「学校」
PORTAL_SCHOOL_NAME=

# ---- 腾讯云集团成员账号（老师自助申请）----
# 凭据用仅授权 organization 接口的 CAM 子账号；留空则「成员账号」页显示「暂未开放」
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_ORGANIZATION_REGION=ap-guangzhou
TENCENTCLOUD_ORGANIZATION_ENDPOINT=organization.tencentcloudapi.com
# tencent=真打腾讯云接口；mock=本地内存假客户端（生产环境禁止，启动即失败）
MEMBER_ACCOUNT_PROVIDER=tencent
# 财务权限 ID：1=查看账单、2=查看余额 必选；3=资金划拨 4=合并出账 5=开票 6=优惠继承
# 7=代付费 8=成本分析 9=预算管理 10=信用额度设置（3、10 需商务开通）
MEMBER_ACCOUNT_PERMISSION_IDS=1,2
# 关系策略，腾讯云目前只支持 Financial
MEMBER_ACCOUNT_POLICY_TYPE=Financial
# 根节点不再配置：新部门自动挂到组织根节点下（多根节点时取 NodeId 最小者）
# 旧 JSON 申请单的一次性导入目录（仅迁移期使用；业务数据存 Postgres portal.member_applications）
PORTAL_DATA_DIR=./.data

# ---- 运行期配置中心 ----
# 可选：加密配置表里的敏感值（腾讯云 AK/SK 等）。留空则从 SESSION_SECRET 派生；
# 生产建议单独配置，轮换 SESSION_SECRET 时不会导致已存密文不可解。
CONFIG_ENCRYPTION_KEY=
