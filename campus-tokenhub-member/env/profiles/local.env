# 本地环境：门户跑在本机 3000 端口，登录走学校 SSO（OAuth2 / CAS）
#
# 由 `npm run env:local` 写入 .env.local 生效。
# 只放「随环境变化」的项；密钥、IdP 凭证、腾讯云凭据仍来自 .env 或设置页。

# 浏览器访问的门户地址（Next 的 basePath 是 /tokenhub/member，所以带前缀）
PUBLIC_BASE_URL=http://localhost:3000/tokenhub/member
# 本地是 http，Secure Cookie 会被浏览器丢弃
COOKIE_SECURE=false
# 侧边栏顶部校名，本地用设计稿的示例校名方便比对
PORTAL_SCHOOL_NAME=演示学校
