# 局域网环境：门户跑在本机，内网其它设备用浏览器访问 http://<本机内网 IP>:3000/tokenhub/portal
#
# 由 `npm run env:lan` 写入 .env.local 生效；__LAN_IP__ 会被替换成当前内网 IPv4，
# 换了网络/IP 重新执行一次即可。密钥、IdP 凭证、网关口令等仍来自 .env。

# 关键项：必须与浏览器实际访问的地址同源（回调、同源校验都以它为准）
PUBLIC_BASE_URL=http://__LAN_IP__:3000/tokenhub/portal
# 浏览器直连网关走 nginx（8088 对外监听 0.0.0.0）；8790 只绑回环，别用
NEXT_PUBLIC_PROXY_BASE=http://__LAN_IP__:8088/tokenhub
# 管理台同样走 nginx 前缀
ADMIN_PUBLIC_BASE_URL=http://__LAN_IP__:8088/tokenhub/admin
# 回调地址必须落在内网 IP 上，否则认证完会跳回访问方自己的 localhost
# 内网仍是 http，Secure Cookie 会被浏览器丢弃
COOKIE_SECURE=false

# 管理台 SSO（docker compose 读的是 .env，这里同步一份便于切换后对照）
PORTAL_LOGIN_URL=http://__LAN_IP__:3000/tokenhub/portal/login
# 服务端代理登出必须走 compose 内网服务名，不能用浏览器侧的 __LAN_IP__
PORTAL_LOGOUT_URL=http://portal:3000/tokenhub/portal/api/auth/logout
ADMIN_AUTH_MODE=portal
