# 本地环境：门户跑在本机 3000 端口，登录仍走标准 SSO（OAuth2 / CAS）
#
# 由 `npm run env:local` 写入 .env.local 生效。
# 这里只放「随环境变化」的项，密钥、IdP 凭证、网关口令等仍来自 .env。

# 浏览器访问的门户地址（Next 的 basePath 是 /tokenhub/portal，所以带前缀）
PUBLIC_BASE_URL=http://localhost:3000/tokenhub/portal
# 学生浏览器直连的推理网关；本地网关代理容器映射在 8790
NEXT_PUBLIC_PROXY_BASE=http://localhost:8790
# 侧边栏「网关管理后台 ↗」的跳转地址。
# 镜像按 .env 的 ADMIN_UI_PUBLIC_PATH=/tokenhub/admin 构建，资源都指向前缀路径，
# 直连 8789 会白屏；本地统一走 nginx 这一跳（它剥掉前缀后转发到 gateway-admin:8789）
ADMIN_PUBLIC_BASE_URL=http://localhost:8088/tokenhub/admin
# 关键项：回调换成 localhost，SSO 认证完才会回到本机，而不是线上域名
# 本地是 http，Secure Cookie 会被浏览器丢弃
COOKIE_SECURE=false
# 侧边栏顶部校名，本地用设计稿的示例校名方便比对
PORTAL_SCHOOL_NAME=演示学校

# 管理台 SSO（docker compose 读的是 .env，这里同步一份便于切换后对照）
# 登录地址只下发浏览器，用 localhost；登出由 gateway-admin 容器服务端转发，
# 必须走 compose 内网服务名，填 localhost 会打到容器自己并得到 502。
PORTAL_LOGIN_URL=http://localhost:3000/tokenhub/portal/login
PORTAL_LOGOUT_URL=http://portal:3000/tokenhub/portal/api/auth/logout
ADMIN_AUTH_MODE=portal
