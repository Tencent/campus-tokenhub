# 双站同域部署的环境变量（配合 docker-compose.dual.yml）
# 复制成 .env.dual 后填写；它只用于「两站同时部署」，单站部署用各仓库自己的 .env。

POSTGRES_USER=octafuse
POSTGRES_PASSWORD=请填强口令
POSTGRES_DB=octafuse

# 两站必须相同：会话 Cookie 的签名密钥。不同则互认失效（各认各的）
# 必须是**高熵**随机串（openssl rand -base64 48）：长度够但字符单一（如 kkkkk…）会被启动校验拒绝，
# 因为 HS256 的密钥空间退化后可以被离线暴力还原，等于任何人都能伪造 admin 会话。
SESSION_SECRET=请填至少32字符的随机串__两站必须一致__

# 可选但强烈建议：配置表里敏感值（腾讯云 AK/SK、OAuth2 client_secret）的加密材料。
# 留空则从 SESSION_SECRET 派生——那样轮换 SESSION_SECRET 会让已存密文一起失效，
# 部署后需要到设置页把所有凭据重填一遍。
CONFIG_ENCRYPTION_KEY=

# ---- 门户调用网关管理接口的集成密钥（必填）----
# 在网关后台「系统集成 → 集成密钥」创建具名最小权限 Key，门户服务端用
# Authorization: Bearer 调 /api/admin/*；门户不再持有网关管理员账号密码。
# 按需授予 users.* / user_keys.* / models.* / routes.* / providers.* /
# providers.secrets.read / config.* / logs.read / analytics.read。
# ⚠️ 不要填示例值，也不要拿网关应急账密代替；两者完全独立。
# 根 docker-compose.yml 与 docker-compose.dual.yml 都用 :? 强制要求本项非空。
OCTAFUSE_ADMIN_API_KEY=

# ---- 网关应急账密（正常部署保持关闭，无需配置）----
# 仅 SSO 故障回滚时，临时在本文件加这三项并重启 gateway-admin：
#   ADMIN_USERNAME=<管理员名>
#   ADMIN_PASSWORD=<强随机口令>
#   ADMIN_PASSWORD_LOGIN=on
# 用完把 ADMIN_PASSWORD_LOGIN 改回空并清空口令。
# 平时不写这三项：compose 会用空值兜底，/api/auth/login 恒 403，
# 也不会把应急口令注入门户容器。门户的 OCTAFUSE_ADMIN_API_KEY 与这里无关。

# 对外根地址（浏览器看到的），必须与 nginx 对外访问的域名一致。
# **只填到 origin**（协议 + 域名 + 端口），不要带 /tokenhub/portal：
# compose 会用这个值拼「成员账号」入口地址与管理台的登录地址，带路径会拼出双前缀。
PUBLIC_BASE_URL=https://api.example.edu.cn

# ---- 两站应用前缀 ----
# 默认值就是 compose 与 nginx 模板当前使用的路径，一般不需要改。
# 改动会同时影响：镜像编译期 basePath、容器健康检查、管理台回跳门户的登录/登出地址；
# 且必须同步修改 deploy/nginx.conf.template（并用 npm run test:admin-nginx 验证）。
PORTAL_ASSIGN_BASE_PATH=/tokenhub/portal
PORTAL_MEMBER_BASE_PATH=/tokenhub/member

# ---- 会话 Cookie 作用域 ----
# Path 必须是两站的公共前缀：/tokenhub/portal 与 /tokenhub/member 都以 /tokenhub 开头。
# 填成各自前缀会让两站各存一份 Cookie，互认断掉。
PORTAL_COOKIE_PATH=/tokenhub
# 留空 = host-only（同域部署最安全）；只有跨子域互认时才填父域，如 .example.edu.cn
PORTAL_COOKIE_DOMAIN=

# 上 TLS 后必须 true，否则浏览器丢弃 Cookie
COOKIE_SECURE=true

# 部署管理员通道（引导期账号密码登录）：**两站共用这一套**（本文件本来就是两站共读一份）。
# 首次启动会把这两项加密写进共享配置，之后库内为准；SSO 确认调通后由运维手动置 off。
PORTAL_ADMIN_USERNAME=
PORTAL_ADMIN_PASSWORD=
PORTAL_ADMIN_LOGIN=auto

# nginx 对外端口（CLB 转发到这里）与协议
NGINX_HOST_PORT=8088
NGINX_HOST_BIND=0.0.0.0
NGINX_PUBLIC_PROTO=https

# 成员自购站的公网基址：compose 会按 PUBLIC_BASE_URL 自动注入
# ${PUBLIC_BASE_URL}/tokenhub/member，门户侧边栏「用户入口」据此显示「成员账号 ↗」。
# 不用在 .env.dual 里重复填写；单站部署的 .env 里该变量留空，入口不显示。
#
# 网关管理后台的浏览器地址（门户侧边栏「网关管理后台 ↗」跳这里）。
# 留空时该入口会提示「门户未配置管理后台地址」。
ADMIN_PUBLIC_BASE_URL=http://localhost:8088/tokenhub/admin

# 管理台「在线调试台」浏览器直连推理网关的地址（compose 默认回落到 http://localhost:8790）
NEXT_PUBLIC_PROXY_BASE=https://api.example.edu.cn/tokenhub

# 必须与 octafuse-admin 镜像**构建时**的 ADMIN_UI_PUBLIC_PATH 一致，
# 否则容器入口脚本的前缀自检会直接 exit 1。线上镜像按 /tokenhub/admin 构建。
ADMIN_UI_PUBLIC_PATH=/tokenhub/admin
